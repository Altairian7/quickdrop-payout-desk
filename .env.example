# Copy to .env and fill in. Everything is optional: without an LLM key the
# service uses its rule-based extractor.
GROQ_API_KEY=your-groq-key-here
LLM_MODEL=openai/gpt-oss-20b
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_TIMEOUT=4

# Set by docker-compose; only needed when running the app outside Docker.
DATABASE_URL=postgresql://qd:qd@localhost:5433/qd

PAYSWIFT_BASE_URL=http://localhost:8081
DATA_DIR=./data
